{
  "entities": {
    "GymMember": {
      "title": "GymMember",
      "type": "object",
      "description": "Dados cadastrais do aluno da academia.",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "plan": { "type": "string", "enum": ["mensal", "trimestral", "anual"] },
        "status": { "type": "string", "enum": ["ativo", "inativo", "pendente"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "plan", "status"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "description": "Registro de mensalidade ou venda.",
      "properties": {
        "userId": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pago", "pendente", "atrasado"] },
        "paymentMethod": { "type": "string", "enum": ["pix", "cedula"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["adesao", "renovacao", "adiantado"] }
      },
      "required": ["userId", "memberId", "amount", "status", "dueDate"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil do gestor da academia e aceitação de termos.",
      "properties": {
        "gymName": { "type": "string" },
        "acceptedTerms": { "type": "boolean" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "email": { "type": "string" },
        "monthlyFee": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "type": "object",
      "description": "Ordem de serviço técnica.",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "equipment": { "type": "string" },
        "btus": { "type": "string" },
        "status": { "type": "string" },
        "value": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "Technician": {
      "title": "Technician",
      "type": "object",
      "description": "Cadastro de colaborador técnico.",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Dados do perfil do gestor." },
    "/users/{userId}/members/{id}": { "schema": "GymMember", "description": "Lista de alunos." },
    "/users/{userId}/payments/{id}": { "schema": "Payment", "description": "Histórico financeiro." },
    "/users/{userId}/serviceOrders/{id}": { "schema": "ServiceOrder", "description": "Ordens de serviço." },
    "/users/{userId}/technicians/{id}": { "schema": "Technician", "description": "Equipe técnica." }
  }
}