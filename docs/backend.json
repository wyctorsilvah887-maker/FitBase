
{
  "entities": {
    "ACAnalysis": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ACAnalysis",
      "type": "object",
      "description": "Registro de análise de problemas ou sintomas de aparelhos de ar condicionado via IA.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "inputText": { "type": "string" },
        "photoUrl": { "type": "string" },
        "aiResponse": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "aiResponse", "createdAt"]
    },
    "MaintenanceGuide": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MaintenanceGuide",
      "type": "object",
      "description": "Guia personalizado de manutenção ou instalação de ar condicionado.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "unitData": { "type": "object" },
        "guide": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "unitData", "guide", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}/acAnalyses/{analysisId}": {
      "schema": { "$ref": "#/entities/ACAnalysis" }
    },
    "/users/{userId}/maintenanceGuides/{guideId}": {
      "schema": { "$ref": "#/entities/MaintenanceGuide" }
    }
  }
}
