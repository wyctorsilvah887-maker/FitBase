
{
  "entities": {
    "ACAnalysis": {
      "title": "ACAnalysis",
      "type": "object",
      "description": "Análise de problemas de ar condicionado via IA.",
      "properties": {
        "userId": { "type": "string" },
        "inputText": { "type": "string" },
        "aiResponse": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "aiResponse", "createdAt"]
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "type": "object",
      "description": "Ordem de serviço técnica.",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "equipment": { "type": "string" },
        "btus": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "em_andamento", "concluido", "cancelado"] },
        "value": { "type": "number" },
        "technicianId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "customerName", "status", "value"]
    },
    "Technician": {
      "title": "Technician",
      "type": "object",
      "description": "Técnico da equipe.",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["ativo", "inativo"] }
      },
      "required": ["userId", "name", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}/acAnalyses/{id}": { "schema": "ACAnalysis", "description": "Histórico de diagnósticos." },
    "/users/{userId}/serviceOrders/{id}": { "schema": "ServiceOrder", "description": "Gestão de OS." },
    "/users/{userId}/technicians/{id}": { "schema": "Technician", "description": "Equipe técnica." }
  }
}
