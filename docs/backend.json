
{
  "entities": {
    "GymMember": {
      "title": "GymMember",
      "type": "object",
      "description": "Dados cadastrais do aluno da academia.",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "plan": { "type": "string", "enum": ["mensal", "trimestral", "anual"] },
        "status": { "type": "string", "enum": ["ativo", "inativo", "pendente"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "plan", "status"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "description": "Registro de mensalidade ou venda.",
      "properties": {
        "userId": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pago", "pendente", "atrasado"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "memberId", "amount", "status", "dueDate"]
    },
    "Settings": {
      "title": "Settings",
      "type": "object",
      "description": "Configurações globais da academia.",
      "properties": {
        "monthlyFee": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}/members/{id}": { "schema": "GymMember", "description": "Lista de alunos matriculados." },
    "/users/{userId}/payments/{id}": { "schema": "Payment", "description": "Histórico de pagamentos e dívidas." },
    "/users/{userId}/settings/config": { "schema": "Settings", "description": "Configurações de planos e valores." }
  }
}
