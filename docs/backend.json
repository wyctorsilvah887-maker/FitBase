
{
  "entities": {
    "TextAnalysis": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TextAnalysis",
      "type": "object",
      "description": "Represents a record of an AI-powered textual analysis of animal food descriptions or symptoms.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the TextAnalysis entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the user who performed this analysis."
        },
        "inputText": {
          "type": "string",
          "description": "The textual description provided by the user."
        },
        "aiResponse": {
          "type": "object",
          "description": "The structured response from the AI."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "inputText",
        "aiResponse",
        "createdAt"
      ]
    },
    "CareGuide": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CareGuide",
      "type": "object",
      "description": "A personalized care guide for a pet.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "petData": {
          "type": "object"
        },
        "guide": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "petData",
        "guide",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}/textAnalyses/{analysisId}": {
      "schema": {
        "$ref": "#/entities/TextAnalysis"
      },
      "description": "Stores individual AI-powered textual analyses."
    },
    "/users/{userId}/careGuides/{guideId}": {
      "schema": {
        "$ref": "#/entities/CareGuide"
      },
      "description": "Stores personalized care guides."
    }
  }
}
