
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Esta regra é a mais abrangente possível para o dono dos dados.
    // Ela permite ler e escrever no documento do usuário E em qualquer subcoleção
    // (como serviceOrders, technicians, etc.) em qualquer profundidade.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Regra específica para o documento raiz do usuário (caso necessário)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
