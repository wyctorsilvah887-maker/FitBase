
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGRA DE OURO: O dono do ID {userId} tem acesso total e irrestrito 
    // a todos os seus documentos e QUALQUER sub-coleção em qualquer profundidade.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Garante acesso ao documento raiz do usuário
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
