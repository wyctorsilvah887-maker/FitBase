rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite acesso total ao nó do usuário e QUALQUER subcoleção abaixo dele
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regra explícita para o documento de perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}