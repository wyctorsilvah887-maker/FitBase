rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra absoluta para o FitBase:
    // O gestor tem acesso total ao seu documento de perfil e a QUALQUER subcoleção abaixo dele (recursivo).
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}