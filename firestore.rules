
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que o usuário autenticado tenha controle total sobre seu próprio nó 
    // e QUALQUER profundidade de subcoleções (allPaths=**)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regra explícita para o documento de perfil (raiz do usuário)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
