rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGRA DEFINITIVA PARA O FITBASE
    match /users/{userId} {
      // Permite ler e escrever o perfil do gestor
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Permite acesso total a TODAS as subcoleções (alunos, pagamentos, etc)
      // O uso do wildcard recursivo {allPaths=**} garante que consultas de listagem funcionem.
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}