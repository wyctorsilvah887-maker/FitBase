rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGRA DEFINITIVA FITBASE:
    // Permite que o gestor (userId) tenha controle total sobre seu documento raiz 
    // e SOBRE QUALQUER subcoleção aninhada (members, payments, serviceOrders, etc).
    // O uso do wildcard recursivo {allPaths=**} é essencial para operações de listagem.
    
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}