
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGRA MESTRA: Permite acesso total recursivo ao dono do diretório /users/{userId}
    // O seletor {document=**} garante que consultas de listagem em sub-coleções 
    // (ex: serviceOrders, technicians) sejam autorizadas automaticamente para o dono.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Garante acesso ao documento raiz do usuário
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
