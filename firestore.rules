
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que o usuário autenticado acesse seu próprio documento de perfil 
    // e todas as suas subcoleções de forma recursiva e irrestrita.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
